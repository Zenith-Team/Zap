<?xml version="1.0"?>
<sprites>
	<sprite string_id="zap:stingby" name="Stingby">
	</sprite>
	
	<sprite string_id="zap:timeclock" name="Time Clock">
		<checkbox nybble="1" title="Use bonus time animation" comment="Can only be used once." category="behavior"/>
		<checkbox nybble="2" title="Use collect animation" category="behavior"/>
		
		<value nybble="5-6" title="Triggering event ID (re-activation)" category="events"/>
		<value nybble="7-8" title="Target event ID (collection)" category="events"/>

		<list nybble="10-12" title="Time Amount" category="behavior">
			<entry value="1">1 seconds</entry>
			<entry value="2">5 seconds</entry>
			<entry value="0">10 second</entry>
			<entry value="3">30 seconds</entry>
			<entry value="4">50 seconds</entry>
			<entry value="5">100 seconds</entry>
		</list>

		<checkbox nybble="9" title="Disable sound effects" category="behavior"/>
		<checkbox nybble="13" title="Subtract time" comment="Bad clock" category="behavior"/>
		<checkbox nybble="14" title="Small clock" category="behavior"/>

		<list nybble="20" title="Movement Type" category="movement">
			<entry value="0">None</entry>
			<entry value="1">Sway Or Spin (68, 69, 116, 118)</entry>
			<entry value="2">Bolt (238)</entry>
			<entry value="3">Path (100)</entry>
			<entry value="4">Two-Way (70)</entry>
			<entry value="6">BoltMushroom (241)</entry>
			<entry value="7">No-bolt Mushroom (242)</entry>
			<entry value="8">Shifting Platform (132)</entry>
			<entry value="9">Spinning (214, 484)</entry>
			<entry value="10">Rolling Hill (265)</entry>
			<entry value="11">Moving Mushroom Lift (210)</entry>
		</list>
        <value nybble="21-22" title="Movement ID" category="movement"/>
	</sprite>
	
	<sprite string_id="zap:angrygrrrol" name="Angry Grrrol">
		<value nybble="5" title="Maximum Speed" category="behavior"/>
		<value nybble="6" title="Acceleration" category="behavior"/>
		<checkbox nybble="7" title="Break Blocks (Sides)" comment="Destroys blocks on collision from the side." category="behavior"/>
		<checkbox nybble="8" title="Break Blocks (Down)" comment="Destroys blocks below." category="behavior"/>
	</sprite>
	
	<sprite string_id="zap:flybones" name="Fly Bones">
	    
	</sprite>

	<sprite string_id="zap:cataquack" name="Cataquack" notes="&lt;font color=&quot;cyan&quot;&gt; &lt;i&gt;To the skies!&lt;/i&gt; &lt;/font&gt;">
	    <value nybble="5-6" title="Launch knockback (X Speed)" comment="In tenths of a non-linear speed unit. See Y speed for details. (Directional)" category="behavior"/>
	    <value nybble="7-8" title="Launch height (Y Speed)" category="behavior" comment="In tenths of a non-linear speed unit.&lt;br&gt; &lt;b&gt;Reference values:&lt;/b&gt; &lt;br&gt; 35 = 3.5 -> ~4 tiles (~7 as mini) &lt;br&gt; 45 = 4.5 -> ~8 tiles (~14 as mini) &lt;br&gt; 55 = 5.5 -> ~13 tiles (~21 as mini) &lt;br&gt; 60 = 6.0 -> ~16 tiles (~26 as mini) &lt;br&gt; 72 = 7.2 -> ~24 tiles (~39 as mini) &lt;br&gt; 82 = 8.2 -> ~32 tiles (~50 as mini) &lt;br&gt; 99 = 9.9 -> ~48 tiles (~72 as mini) &lt;br&gt; 119 = 11.9 -> ~64 tiles (~92 as mini) &lt;br&gt; 221 = 22.1 -> ~128 tiles (~188 as mini) &lt;br&gt; 255 = 25.5 -> ~149 tiles (~200+ as mini)"/>
	</sprite>

