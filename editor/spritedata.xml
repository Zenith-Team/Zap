	<sprite string_id="zap:clef" name="Clef" notes="A clef that spawns multiple music notes when collected. Collect them all within the time limit for an item!">
        <value nybble="1-2" title="Manager ID" category="behavior"/>
        <value nybble="3-4" title="Target Note Count" comment="The required number of notes with a matching ID to activate an event." category="behavior"/>
        <list nybble="5" title="Reward" comment="The reward once all notes are collected." category="behavior">
            <entry value="0" comment="Useful for event activation">None</entry>
			<entry value="1">Mushroom</entry>
            <entry value="2">Fire Flower</entry>
            <entry value="3">Ice Flower</entry>
            <entry value="4">Mini Mushroom</entry>
            <entry value="5">Propeller Mushroom</entry>
            <entry value="6">Penguin</entry>
            <entry value="7">Acorn</entry>
            <entry value="8">1-up Mushroom</entry>
            <entry value="9">3-up Moon</entry>
        </list>
        <value nybble="6-7" title="Time Limit" comment="Time limit in real seconds to collect all notes for each round." category="behavior"/>
		<value nybble="8" title="Phases" comment="Number of phases/collection rounds of notes for the player to collect. Limited to a max of 8 rounds." category="behavior"/>
		<value nybble="9" title="Allowed Retries" comment="The clef respawns and allows the player to re-attempt the minigame" category="behavior"/>
		
		<value nybble="10-11" title="Target Event ID (Game won)" id_type="event" category="events"/>

        <list nybble="20" title="Movement Type" category="movement">
			<entry value="0">None</entry>
			<entry value="1">Sway Or Spin (68, 69, 116, 118)</entry>
			<entry value="2">Bolt (238)</entry>
			<entry value="3">Path (100)</entry>
			<entry value="4">Two-Way (70)</entry>
			<entry value="6">BoltMushroom (241)</entry>
			<entry value="7">No-bolt Mushroom (242)</entry>
			<entry value="8">Shifting Platform (132)</entry>
			<entry value="9">Spinning (214, 484)</entry>
			<entry value="10">Rolling Hill (265)</entry>
			<entry value="11">Moving Mushroom Lift (210)</entry>
		</list>
        <value nybble="21-22" title="Movement ID" category="movement"/>

	</sprite>

	<sprite string_id="zap:jumboray" name="Jumbo Ray">
		<value nybble="5-6" title="Altitude" comment="In tiles." category="behavior"/>
		<list nybble="7" title="Horizontal Direction" category="behavior">
			<entry value="0">Right</entry>
			<entry value="1">Left</entry>
		</list>
		<list nybble="8" title="Vertical Direction" category="behavior">
			<entry value="0">Up</entry>
			<entry value="1">Down</entry>
		</list>
		<value nybble="9-10" title="Arc Duration" comment="In seconds from the start point to when it reaches the same Y altitude at the end. Essentially changes the width of the arc." category="behavior"/>
	</sprite>
	
	<sprite string_id="zap:jumborayspawner" name="Jumbo Ray Spawner">
		<value nybble="5-6" title="Altitude" comment="In tiles." category="behavior"/>
		<list nybble="7" title="Horizontal Direction" category="behavior">
			<entry value="0">Right</entry>
			<entry value="1">Left</entry>
		</list>
		<list nybble="8" title="Vertical Direction" category="behavior">
			<entry value="0">Up</entry>
			<entry value="1">Down</entry>
		</list>
		<value nybble="9-10" title="Arc Duration" comment="In seconds from the start point to when it reaches the same Y altitude at the end. Essentially changes the width of the arc." category="behavior"/>
		
		<value nybble="1-2" title="Interval" comment="How many seconds between each spawn." category="behavior"/>
		<value nybble="3" title="Limit" comment="If set, will stop spawning after this many." category="behavior"/>
		<value nybble="21-22" title="Triggering Event ID" comment="If set, will only spawn when this event is active." id_type="event" category="events"/>
	</sprite>
	
